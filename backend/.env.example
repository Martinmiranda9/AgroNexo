# ============================================================
# AgroConnect - Plantilla de variables de entorno
# Copiar este archivo a .env y completar con valores reales.
# El archivo .env NUNCA debe commitarse al repositorio.
# ============================================================

# Cadena de conexion a PostgreSQL
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=agroconnect_db;Username=postgres;Password=TU_PASSWORD_AQUI

# Auth0
Auth0__Domain=agroconnect-dev.us.auth0.com
Auth0__Audience=https://api.agroconnect.com

# Entorno (Development | Staging | Production)
ASPNETCORE_ENVIRONMENT=Development
