# ============================================================
# AgroNexo Frontend - Environment Variables Template
# Copy this file to .env.local and fill in the actual values.
# .env.local must NEVER be committed to version control.
# ============================================================

# Auth0 Configuration
AUTH0_SECRET=replace_with_a_long_random_string_min_32_chars
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=https://agroconnect-dev.us.auth0.com
AUTH0_CLIENT_ID=replace_with_auth0_client_id
AUTH0_CLIENT_SECRET=replace_with_auth0_client_secret
# Debe coincidir con Auth0:Audience del backend (API registrada en Auth0).
AUTH0_AUDIENCE=https://api.agroconnect.com
# Conexión de base de datos de usuarios (correo y contraseña). Es el nombre por defecto de Auth0.
AUTH0_DB_CONNECTION=Username-Password-Authentication
# El formulario de correo y contraseña usa el grant "Password" de Auth0. Para habilitarlo:
#   Dashboard > Applications > tu app > Settings > Advanced > Grant Types > tildar "Password"
#   Dashboard > Settings > General > API Authorization Settings > Default Directory = Username-Password-Authentication
# Sin estas variables el login queda desactivado y el registro usa un token de desarrollo.
# En Auth0: activar la conexión "google-oauth2" para esta aplicación y agregar
# http://localhost:3000/api/auth/callback a "Allowed Callback URLs" y http://localhost:3000 a "Allowed Logout URLs".

# Backend API Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000
