# ============================================================
# AgroNexo Frontend - Environment Variables Template
# Copy this file to .env.local and fill in the actual values.
# .env.local must NEVER be committed to version control.
# ============================================================

# Firebase Configuration — pública, no son secretos (frontend/src/core/auth/firebase-client.ts).
# Consola de Firebase > Configuración del proyecto > Tus apps > agregar app web > "firebaseConfig".
# Debe ser el mismo proyecto que el Firebase:ProjectId del backend.
NEXT_PUBLIC_FIREBASE_API_KEY=replace_with_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=replace_with_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace_with_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=replace_with_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace_with_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=replace_with_app_id
# Sin estas variables el login queda desactivado y el registro usa un token de desarrollo.
# En Firebase Console: Authentication > Sign-in method > habilitar "Correo electrónico/contraseña" y
# "Google". El branding del popup de Google (nombre y logo) se edita en Google Cloud Console >
# APIs & Services > OAuth consent screen (mismo proyecto).

# Backend API Configuration
# Lo usan el navegador Y el servidor de Next (route handlers y server components). En Vercel tiene que ser una URL
# pública del backend (hosting o túnel al Docker local): http://localhost:5000 no existe desde Vercel y, sin
# backend, ni los ya registrados pueden entrar (el login muestra "No pudimos conectarnos").
NEXT_PUBLIC_API_URL=http://localhost:5000

# IA de la búsqueda asistida (Google AI Studio / Gemini). Solo servidor: NUNCA con prefijo NEXT_PUBLIC_.
# Clave gratuita en https://aistudio.google.com/apikey. Sin clave la pantalla funciona igual con el intérprete local.
# En el plan gratuito Google puede usar lo que se envía para mejorar sus productos: antes de producción con datos
# reales, pasar a un proyecto con facturación activada.
GEMINI_API_KEY=replace_with_google_ai_studio_key
# Opcional: cambiar de modelo sin tocar código (por defecto gemini-3.5-flash-lite).
# GEMINI_MODEL=gemini-3.5-flash-lite
